# Vocal Muse — Environment Configuration Example
# Copy this file to .env and fill in values as needed.
# None of these are required — the app runs 100% locally without them.

# === Supabase Cloud Backend (Optional) ===
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# === Local LLM Configuration (Optional — default is Ollama / LM Studio at http://localhost:1234/v1) ===
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-7b

# === Local Whisper Configuration (Optional — default is http://localhost:9000) ===
# WHISPER_BASE_URL=http://localhost:9000
# WHISPER_MODEL=Systran/faster-whisper-base.en
